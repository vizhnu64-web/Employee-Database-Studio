# ========================================================
# Employee Database Studio — Production Web Environment Variables
# ========================================================

# --------------------------------------------------------
# REQUIRED ENVIRONMENT VARIABLES
# --------------------------------------------------------

# 1. Hosted PostgreSQL Database Connection String
# Compatible with Neon, Supabase, Cloud SQL, AWS RDS, Render, etc.
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL="postgresql://postgres:password@ep-sample-host.region.aws.neon.tech/peopledesk?sslmode=require"

# 2. JWT Secret for Session Authentication & Token Signing (32+ character secure key)
JWT_SECRET="peopledesk_studio_secure_jwt_secret_key_change_in_production_3829104"

# 3. Initial System Administrator password generated during first-time database initialization
# Default username: admin
INITIAL_ADMIN_PASSWORD="admin123"

# --------------------------------------------------------
# OPTIONAL ENVIRONMENT VARIABLES
# --------------------------------------------------------

# Node Environment ('production' for live Cloud deployment, 'development' for local)
NODE_ENV="production"

# Application Listening Port (defaults to 3000 or port assigned by host)
PORT=3000

# Optional Server-Side SMTP Configuration for Payslip Email Delivery
# During initial deployment, SMTP is completely optional. The application
# starts cleanly without SMTP, and an authorized administrator can configure
# and verify SMTP server settings later via Company Settings.
# No fake or hardcoded credentials are used.
#
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="payroll@yourcompany.com"
# SMTP_PASS="your-smtp-password"
# SMTP_SENDER_NAME="Employee Database Studio Payroll"
# SMTP_SENDER_EMAIL="payroll@yourcompany.com"

