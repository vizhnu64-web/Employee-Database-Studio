# ========================================================
# Employee Database Studio — Production Environment Variables
# ========================================================

# --------------------------------------------------------
# REQUIRED BACKEND ENVIRONMENT VARIABLES (NEVER EXPOSE TO CLIENT)
# --------------------------------------------------------

# 1. Hosted PostgreSQL Database Connection String (Pooler / Runtime)
# Set from Supabase Project Settings -> Database -> Connection String (Transaction/Session Pooler)
# Note: App reads DATABASE_URL first and falls back to POSTGRES_URL automatically.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require"

# Optional direct/non-pooling Postgres connection used by scripts/migrate.ts
# POSTGRES_URL_NON_POOLING="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# 2. JWT Secret for Session Authentication & Token Signing (32+ random characters)
# Generate locally with: openssl rand -base64 48
JWT_SECRET="replace_with_a_strong_64_char_random_secret_before_deploying"

# 3. Initial System Administrator password (only used when creating the first admin user)
# Default username: admin
INITIAL_ADMIN_PASSWORD="replace_with_strong_initial_admin_password"

# 4. Private Supabase Storage Configuration (Server-Side Only)
# Set from Supabase Project Settings -> API -> Project URL & service_role key
SUPABASE_URL="https://<your-project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace_with_supabase_service_role_key"

# --------------------------------------------------------
# OPTIONAL ENVIRONMENT VARIABLES
# --------------------------------------------------------

# Node Environment ('production' on Vercel, 'development' for local)
NODE_ENV="development"

# Application Listening Port (defaults to 3000)
PORT=3000

# Optional Server-Side SMTP Configuration for Payslip Email Delivery
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="payroll@yourcompany.com"
# SMTP_PASS="your-smtp-password"
# SMTP_SENDER_NAME="Employee Database Studio Payroll"
# SMTP_SENDER_EMAIL="payroll@yourcompany.com"
