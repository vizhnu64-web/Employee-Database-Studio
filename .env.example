# ========================================================
# PeopleDesk Studio — Production Web Environment Variables
# ========================================================

# Hosted PostgreSQL Database Connection String
# Compatible with Neon, Supabase, Cloud SQL, AWS RDS, Render, etc.
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL="postgresql://postgres:password@ep-sample-host.region.aws.neon.tech/peopledesk?sslmode=require"

# JWT Secret for Session Authentication & Token Signing (generate a secure random 32+ char key)
JWT_SECRET="peopledesk_studio_secure_jwt_secret_key_change_in_production_3829104"

# Initial System Administrator account password generated during first-time database initialization
# Default username: admin
INITIAL_ADMIN_PASSWORD="admin123"

# Node Environment ('production' for live Vercel/Cloud deployment, 'development' for local)
NODE_ENV="production"

# Application Listening Port (automatically provided by hosting environment)
PORT=3000

# Optional Server-Side SMTP Configuration for Payslip Email Delivery
# (These can also be configured and tested in the UI under Email Delivery / Settings)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="payroll@yourcompany.com"
SMTP_PASS="your-smtp-password"
SMTP_SENDER_NAME="PeopleDesk Studio Payroll"
SMTP_SENDER_EMAIL="payroll@yourcompany.com"
