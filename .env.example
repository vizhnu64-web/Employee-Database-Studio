# ========================================================
# Employee Database Studio — Environment Variables
# ========================================================

# --------------------------------------------------------
# GOOGLE IDENTITY SERVICES & WORKSPACE APIs (CLIENT-SIDE OAUTH)
# --------------------------------------------------------

# Public Google OAuth 2.0 Web Client ID (no client secret needed in browser GIS flow)
# Configure Authorized JavaScript Origins in Google Cloud Console for localhost & Vercel domain.
VITE_GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# --------------------------------------------------------
# OPTIONAL COMPANY SMTP SERVER (INDEPENDENT OF GOOGLE OAUTH)
# --------------------------------------------------------

# Configured strictly on the backend server; never exposed to browser storage or Google Sheets.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="payroll@yourcompany.com"
# SMTP_PASS="your-smtp-password"
# SMTP_SENDER_NAME="Employee Database Studio Payroll"
# SMTP_SENDER_EMAIL="payroll@yourcompany.com"

# Node Environment ('production' on Vercel, 'development' for local)
NODE_ENV="development"
PORT=3000
